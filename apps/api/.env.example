# Copie ce fichier en .env (jamais commité) puis ajuste.

# auto : essaie les sources réelles, repli sur données démo si indisponibles
# demo : 100 % hors-ligne (données fictives réalistes, étiquetées comme telles)
# live : sources réelles uniquement (les pannes remontent en erreur)
DATA_MODE=auto

# Optionnel — active le résumé IA du dashboard et le copilote.
# Sans clé : résumés générés par règles, copilote désactivé proprement.
# Crée ta clé sur https://platform.claude.com
ANTHROPIC_API_KEY=

# Modèles (défauts pensés budget étudiant ; claude-opus-5 = qualité maximale)
ANTHROPIC_COPILOT_MODEL=claude-sonnet-5
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5

# SQLite par défaut ; une URL PostgreSQL suffit pour changer de base
DATABASE_URL=sqlite:///./investcopilot.db

# Origines autorisées à appeler l'API (frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
